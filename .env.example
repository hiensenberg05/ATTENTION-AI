# Copy to .env and fill in. .env is gitignored; this template is not.

# Required for the agent decision layer (Groq, model openai/gpt-oss-20b).
# Without it the backend still runs: decisions fall back to the deterministic
# policy engine and are marked decided_by="policy_engine_fallback".
GROQ_API_KEY=

# --- Optional executor settings ------------------------------------------
# Where the mock HR application is served.
# MOCK_HR_BASE_URL=http://127.0.0.1:8000/mock-hr

# Set to false to watch the browser drive the HR system during a demo.
# PLAYWRIGHT_HEADLESS=true

# Per-action Playwright timeout, in milliseconds.
# PLAYWRIGHT_TIMEOUT_MS=10000
